{
  "name": "@murphys/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Shared domain models, 1:1 Swift/TypeScript interfaces, static catalogs, and RBAC definitions",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "demo:reset": "tsc && node dist/scripts/resetDemoEnvironment.js",
    "seed:sandbox": "tsc && node dist/scripts/seedSandbox.js",
    "seed:users": "tsc && node dist/scripts/seedLiveUsersAndGroups.js",
    "link:users": "tsc && node dist/scripts/linkAuthUsersToFirestore.js",
    "normalize:users": "tsc && node dist/scripts/normalizeUserRoles.js",
    "clone:sandbox-to-live": "tsc && node dist/scripts/cloneSandboxToLive.js",
    "import:wex": "tsc && node dist/scripts/importWexCustomers.js"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "firebase-admin": "^14.3.0"
  }
}
